# Администратор создаётся при первом запуске (дальше пароль меняется в самой админке)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Домены, по которым открывается сайт
ALLOWED_HOSTS=example.com,www.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# 1 — cookie только по HTTPS (включить на проде за nginx с сертификатом)
COOKIE_SECURE=1
# необязательно: иначе ключ генерируется и хранится в /data/secret.key
DJANGO_SECRET_KEY=
